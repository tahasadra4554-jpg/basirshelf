# --- Supabase (Dashboard → Project Settings → API) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only needed for handout uploads to Supabase Storage + admin tasks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" ONLY for migrations/seeding — bypasses RLS.
SUPABASE_USE_SERVICE_ROLE=false

# --- App --------------------------------------------------------------------
# HMAC secret that signs the hidden teacher-login session cookie.
# Generate one:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string
